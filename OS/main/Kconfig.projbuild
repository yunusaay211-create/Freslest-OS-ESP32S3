menu "Freslest FreStore"
config FRESLEST_STORE_ORIGIN
    string "HTTPS origin, without a path or trailing slash"
    default ""
    help
        Use a certificate that chains to the ESP-IDF root bundle.
        FreStore can also add a personal HTTPS server from its Server menu.

config FRESLEST_STORE_PUBLIC_KEY
    string "Publisher ECDSA P-256 public key (base64 DER)"
    default ""
    help
        Use the public key printed by FreStore keygen.
        Never include the private key in firmware.
endmenu
